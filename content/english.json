  ]
 }},

{"id":"e06","name":"be동사 부정·질문","level":2,"prereq":["e02"],"minutes":12,
 "body":["# 아니라고 할 때: be동사 + not",{"img": "e06-beq.svg", "cap": "not은 be동사 뒤, 질문은 be동사를 앞으로"},["I'm not tired.","나는 안 피곤해요."],["He isn't here.","그는 여기 없어요."],["They aren't busy.","그들은 바쁘지 않아요."],
  "! is not = isn't, are not = aren't. am not은 줄이지 않고 I'm not이라고 해요.",
  "# 물을 때: be동사를 맨 앞으로",["Are you ready?","준비됐어요?"],["Is she your friend?","그녀가 네 친구야?"],
  "대답: Yes, I am. / No, I'm not. / Yes, she is. / No, she isn't."],
 "items":{
  "lesson":[
   {"q":"'그는 학생이 아니에요'는?","c":["He isn't a student.","He not is a student.","He don't a student.","He aren't a student."]},
   {"type":"order","q":"순서대로: 너 배고파?","t":["hungry","Are","you"],"a":"Are you hungry"},
   {"q":"'Is it hot?'에 '아니요'로 답하면?","c":["No, it isn't.","No, it aren't.","No, it don't.","No, is it."]},
   {"say":"Are you okay?","q":"들은 말의 뜻은?","c":["괜찮아요?","좋아요.","네, 괜찮아요.","안 괜찮아요."]}],
  "diag":[
   {"q":"빈칸: We ___ late. (우리는 안 늦었어요)","c":["aren't","isn't","amn't","don't"]},
   {"type":"order","q":"순서대로: 그녀는 집에 있어요?","t":["home","Is","at","she"],"a":"Is she at home"},
   {"q":"'Are they your parents?'에 '네'로 답하면?","c":["Yes, they are.","Yes, they is.","Yes, I am.","Yes, they do."]}],
  "month":[
   {"type":"fill","q":"I'm ___ sad. (나는 슬프지 않아요)","a":["not"]}],
  "review": [
   {"q":"문법에 맞는 부정문을 고르세요.","c":["The door isn't open.","The door not is open.","The door don't open.","The door aren't open."]},
   {"q":"다음 단어를 바른 순서로 배열한 문장은? Are / they / busy?","c":["Are they busy","They are busy","Busy are they","Are busy they"]},
   {"q":"빈칸에 알맞은 말을 고르세요: ___ your mother at work?","c":["Is","Are","Am","Does"]},
   {"q":"'Are we early?'에 '아니요'라고 답할 때 빈칸에 알맞은 말은? No, ___.","c":["we aren't","we isn't","we don't","we am not"]},
   {"q":"빈칸에 알맞은 말을 고르세요: I ___ afraid.","c":["am not","isn't","aren't","don't"]},
   {"q":"들은 질문은 무엇을 묻나요?","c":["그들이 집에 있는지","그들이 집에 갔는지","그들이 바쁜지","그들이 집을 좋아하는지"],"say":"Are they at home?"}
  ]
 }},

{"id":"e07","name":"일반동사 현재 (like / likes)","level":2,"prereq":["e02","e03"],"minutes":12,
 "body":["# 일반동사 = 행동·상태를 나타내는 말 (like, go, eat, work …)",{"img": "e07-s.svg", "cap": "he · she · it이면 동사에 -s"},["I like coffee.","나는 커피를 좋아해요."],["We go to church on Sunday.","우리는 일요일에 교회에 가요."],
  "# he·she·it(한 사람·하나)이면 동사 끝에 -s",["She likes music.","그녀는 음악을 좋아해요."],["He works at a bank.","그는 은행에서 일해요."],
