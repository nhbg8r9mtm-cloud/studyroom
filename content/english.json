   {"q":"19를 영어로?","c":["nineteen","ninety","ninteen","nine-ten"]},
   {"type":"fill","q":"40 = ___","a":["forty"]}],
  "month":[
   {"say":"My son is seventeen.","q":"아들은 몇 살?","c":["17","70","7","27"]}],
  "review": [
   {"q":"'sixty-four'는 몇을 뜻하나요?","c":["64","46","16","60"]},
   {"q":"들은 영어 숫자에 해당하는 숫자를 고르세요.","c":["21","12","20","31"],"say":"twenty-one"},
